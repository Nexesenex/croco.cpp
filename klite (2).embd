						</li>
						<li class="nav-item hidden" id="topbtn_multiplayer_leave">
							<a class="nav-link mainnav" href="#" onclick="leave_multiplayer()">Exit Multiplayer</a>
						</li>
					</ul>
				</div>

			</div>
